# ── KAIROS core ────────────────────────────────────────────────────────────────
KAIROS_ENV=development                 # production disables /dev/* endpoints
KAIROS_API_KEY=                        # set in production: clients send it as X-API-Key
KAIROS_PIPELINE_INTERVAL_MIN=15
KAIROS_SCHEDULER_ENABLED=true
# KAIROS_DB_PATH=kairos.duckdb
# KAIROS_DATA_DIR=data
# KAIROS_SOURCES_FILE=sources.yaml
# KAIROS_CORS_ORIGINS=http://localhost:5173,https://kairos-app.vercel.app

# ── Detection, causal analysis, alerting ───────────────────────────────────────
KAIROS_Z_THRESHOLD=3.5
KAIROS_USE_PROPHET=true
KAIROS_CAUSAL_LAGS=1
KAIROS_ALERT_MIN_SEVERITY=medium       # low | medium | high | critical
KAIROS_ALERT_COOLDOWN_MIN=60

# ── LLM (optional: without it KAIROS writes grounded template reports) ──────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Alert delivery ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL=

# ── Connector secrets (referenced from sources.yaml as password_env / ${VAR}) ──
DEMO_FTP_PASS=kairos-demo
DEMO_API_TOKEN=demo-token
# GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json
